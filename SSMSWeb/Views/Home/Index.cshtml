@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Connexion à l'instance SQL Server</h1>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="form-group mb-3">
                    <label for="serverName" class="form-label">Nom du serveur :</label>
                    <input type="text" id="serverName" class="form-control" placeholder="Ex: localhost ou .\SQLEXPRESS">
                </div>

                <div class="form-group mb-3">
                    <label for="authType" class="form-label">Authentification :</label>
                    <select id="authType" class="form-select form-control" onchange="authTypeChanged(this.value);">
                        <option value="windows">Authentification Windows</option>
                        <option value="sql">Authentification SQL Server</option>
                    </select>
                </div>

                <div id="sqlAuthFields" style="display: none;">
                    <div class="form-group mb-3">
                        <label for="username" class="form-label">Nom d'utilisateur :</label>
                        <input type="text" id="username" class="form-control" placeholder="Nom d'utilisateur">
                    </div>
                    <div class="form-group mb-3">
                        <label for="password" class="form-label">Mot de passe :</label>
                        <input type="password" id="password" class="form-control" placeholder="Mot de passe">
                    </div>
                </div>

                <div class="mt-4 text-center">
                    <div id="connectionZone">
                        <button class="button-connection btn btn-primary w-100" onclick="connect()">Connect to instance</button>
                    </div>
                    <div id="disconnectZone" style="display: none;" class="mt-3">
                        <button class="button-disconnect btn btn-danger w-100" onclick="disconnect()">Disconnect</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="databasesZone" class="row justify-content-center mt-4" style="display: none;">
    <div class="col-md-8">
        <div class="text-center">
            <button class="button-see-databases btn btn-secondary me-2 mb-3" onclick="displayDatabases()">Display databases</button>
        </div>

        <!-- DB list -->
        <div>
            <ul id="databasesList" class="list-group">

            </ul>
        </div>
    </div>
</div>
