@{
    ViewData["Title"] = "Connexion";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <strong>Connexion &agrave; l'instance SQL Server</strong>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="serverName" class="form-label">Nom du serveur</label>
                    <input type="text" id="serverName" class="form-control" placeholder="localhost ou .\SQLEXPRESS">
                </div>
                <div class="mb-3">
                    <label for="authType" class="form-label">Authentification</label>
                    <select id="authType" class="form-select" onchange="authTypeChanged(this.value)">
                        <option value="windows">Authentification Windows</option>
                        <option value="sql">Authentification SQL Server</option>
                    </select>
                </div>
                <div id="sqlAuthFields" style="display:none">
                    <div class="mb-3">
                        <label for="username" class="form-label">Nom d'utilisateur</label>
                        <input type="text" id="username" class="form-control" autocomplete="username">
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Mot de passe</label>
                        <input type="password" id="password" class="form-control" autocomplete="current-password">
                    </div>
                </div>
                <div id="connectionError" class="alert alert-danger py-2 mb-2" style="display:none"></div>
                <button id="connectBtn" class="btn btn-primary w-100" onclick="connect()">
                    Se connecter
                </button>
            </div>
        </div>
    </div>
</div>
